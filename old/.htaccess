AddDefaultCharset UTF-8
Options All -Indexes
DirectoryIndex index.php

RewriteEngine On
RewriteBase /old/

# Старая главная /old/ не должна отдавать 200
RewriteRule ^$ https://aquadt.by/ [R=301,L]

# Устаревший sitemap содержит /production
RewriteRule ^sitemap\.xml$ https://aquadt.by/sitemap.xml [R=301,L]

# Прямые 301 на канонические URL. Абсолютный https — один хоп с http и с ipv6
RewriteRule ^landing/?$ https://aquadt.by/ [R=301,L]
RewriteRule ^production/?$ https://aquadt.by/production [R=301,L]
RewriteRule ^(service|stabilized-moss|hardscape|japan|decoration|pseudo-sea|sea|nature|form|payment|ponds|thanks)/?$ https://aquadt.by/$1 [R=301,L]

RewriteRule ^index\.php$ - [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?ws_path=$1 [L,QSA]
