# AquaDT — лендинг, чистые URL разделов, 301 со старых адресов

<Files ".env">
  Require all denied
</Files>

AddDefaultCharset UTF-8
Options -Indexes
DirectoryIndex index.html index.php

RewriteEngine On
RewriteBase /

# ipv6.aquadt.by → https://aquadt.by с сохранением пути (один 301, без цепочки через HTTPS того же хоста)
RewriteCond %{HTTP_HOST} ^ipv6\. [NC]
RewriteRule ^(.*)$ https://aquadt.by/$1 [R=301,L]

# HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# www → без www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# index.html → канонический корень
RewriteRule ^index\.html$ / [R=301,L]

# Кластер изготовления: прямые 301 на главную, без цепочки через /old/production
RewriteRule ^production/?$ / [R=301,L]
RewriteRule ^old/production/?$ / [R=301,L]

# Старые адреса разделов → чистые URL (один 301)
RewriteRule ^old/(service|stabilized-moss|hardscape|japan|decoration|pseudo-sea|sea|nature|form|payment|ponds|thanks)/?$ /$1 [R=301,L]

# Убрать завершающий слэш (кроме корня и реальных директорий)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Старый URL лендинга → новая главная
RewriteRule ^landing/?$ / [R=301,L]

# Не индексировать технические .php посадочных
RewriteCond %{THE_REQUEST} \s/+(service|stabilized-moss|hardscape|japan|decoration)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Чистые посадочные (200)
RewriteRule ^(service|stabilized-moss|hardscape|japan|decoration)$ /$1.php [L]

# Прочие постоянные страницы старого сайта: 200 на чистом URL, внутренний rewrite на CMS
RewriteRule ^(pseudo-sea|sea|nature|form|payment|ponds|thanks)$ /old/index.php?ws_path=$1 [L,QSA]

# Ресурсы и служебные пути старого сайта
RewriteRule ^resource/(.*)$ /old/resource/$1 [L]
RewriteRule ^admin/(.*)$ /old/admin/$1 [R=301,L]
RewriteRule ^install/(.*)$ /old/install/$1 [R=301,L]

# Существующие файлы/папки — без перезаписи
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 7 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(avif|webp|jpg|jpeg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

AddType image/avif avif
AddType image/webp webp
AddType font/woff2 .woff2
