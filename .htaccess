# AquaDT — лендинг, чистые URL разделов, 301 со старых адресов

<Files ".env">
  Require all denied
</Files>

AddDefaultCharset UTF-8
Options -Indexes
DirectoryIndex index.html index.php

RewriteEngine On
RewriteBase /

# ipv6: устаревшие пути сразу на конечный канонический URL, без второго 301
RewriteCond %{HTTP_HOST} ^ipv6\. [NC]
RewriteRule ^(production|old/production)/?$ https://aquadt.by/ [R=301,L]
RewriteCond %{HTTP_HOST} ^ipv6\. [NC]
RewriteRule ^old/?$ https://aquadt.by/ [R=301,L]
RewriteCond %{HTTP_HOST} ^ipv6\. [NC]
RewriteRule ^old/(service|stabilized-moss|hardscape|japan|decoration|pseudo-sea|sea|nature|form|payment|ponds|thanks)/?$ https://aquadt.by/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^ipv6\. [NC]
RewriteRule ^(index\.html|landing)/?$ https://aquadt.by/ [R=301,L]
RewriteCond %{HTTP_HOST} ^ipv6\. [NC]
RewriteRule ^(service|stabilized-moss|hardscape|japan|decoration)\.php$ https://aquadt.by/$1 [R=301,L]

# ipv6.aquadt.by → https://aquadt.by с сохранением пути (один 301)
RewriteCond %{HTTP_HOST} ^ipv6\. [NC]
RewriteRule ^(.*)$ https://aquadt.by/$1 [R=301,L]

# Прямой 301 на конечный https, в том числе с http:// — без цепочки http→https→канонический
RewriteRule ^(production|old/production)/?$ https://aquadt.by/ [R=301,L]
RewriteRule ^old/?$ https://aquadt.by/ [R=301,L]
RewriteRule ^old/sitemap\.xml$ https://aquadt.by/sitemap.xml [R=301,L]
RewriteRule ^old/(service|stabilized-moss|hardscape|japan|decoration|pseudo-sea|sea|nature|form|payment|ponds|thanks)/?$ https://aquadt.by/$1 [R=301,L]
RewriteRule ^(index\.html|landing)/?$ https://aquadt.by/ [R=301,L]

# HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# www → без www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Убрать завершающий слэш (кроме корня и реальных директорий)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Не индексировать технические .php посадочных и обёртку CMS
RewriteCond %{THE_REQUEST} \s/+(service|stabilized-moss|hardscape|japan|decoration)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+cms-page\.php[\s?] [NC]
RewriteRule ^cms-page\.php$ https://aquadt.by/ [R=301,L]

# Чистые посадочные (200)
RewriteRule ^(service|stabilized-moss|hardscape|japan|decoration)$ /$1.php [L]

# Прочие постоянные страницы: 200 на чистом URL, canonical дописывает обёртка
RewriteRule ^(pseudo-sea|sea|nature|form|payment|ponds|thanks)$ /cms-page.php?ws_path=$1 [L,QSA]

# Ресурсы и служебные пути старого сайта
RewriteRule ^resource/(.*)$ /old/resource/$1 [L]
RewriteRule ^admin/(.*)$ /old/admin/$1 [R=301,L]
RewriteRule ^install/(.*)$ /old/install/$1 [R=301,L]

# Существующие файлы/папки — без перезаписи
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 7 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(avif|webp|jpg|jpeg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

AddType image/avif avif
AddType image/webp webp
AddType font/woff2 .woff2
